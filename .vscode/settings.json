{
    "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
    "js/ts.tsserver.watchOptions": {
        "watchFile": "useFsEvents",
        "watchDirectory": "useFsEvents"
    },
    "js/ts.preferences.includePackageJsonAutoImports": "off",
    "js/ts.suggest.enabled": false,
    "typescript.tsserver.useSeparateSyntaxServer": false,
    "js/ts.tsserver.maxMemory": 1024,
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/**": true,
        "**/.cache/**": true,
        "**/coverage/**": true,
        "**/.nyc_output/**": true,
        "**/.turbo/**": true,
        "**/.vercel/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.next": true,
        "**/dist": true,
        "**/build": true,
        "**/.cache": true,
        "**/coverage": true,
        "**/.nyc_output": true,
        "**/.turbo": true,
        "**/.vercel": true
    },
    "editor.codeActionsOnSave": {},
    "editor.quickSuggestions": {
        "strings": false
    },
    "js/ts.validate.enabled": false
}
